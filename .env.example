# ── Supabase (optional — app works without it using in-memory store) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Baileys WhatsApp Gateway (normal WhatsApp account) ────────────────────────
# URL of the Baileys gateway process (default: http://localhost:3001)
BAILEYS_GATEWAY_URL=http://localhost:3001

# Secret key shared between Next.js and the gateway (change this!)
BAILEYS_GATEWAY_SECRET=baileys-local-secret

# WhatsApp Group ID to send reminders to (ends in @g.us)
# Run: node baileys/list-groups.mjs  ← after scanning QR in gateway
# Example: WHATSAPP_GROUP_ID=120363XXXXXXXXXX@g.us
WHATSAPP_GROUP_ID=

# Gateway HTTP port (default 3001)
BAILEYS_PORT=3001

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata

# ── Vercel Cron Secret (protects /api/cron/reminders) ────────────────────────
CRON_SECRET=your_secure_cron_secret_string_here

# ── Legacy: Meta WhatsApp Cloud API (no longer used, kept for reference) ──────
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=109283746592019
# WHATSAPP_API_VERSION=v20.0
# WHATSAPP_TEMPLATE_NAME=task_reminder
